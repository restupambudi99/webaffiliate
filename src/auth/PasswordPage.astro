---
interface Props { mode: 'login' | 'setup' }
const { mode } = Astro.props;
const setup = mode === 'setup';
const title = setup ? 'Buat password baru' : 'Masuk ke MyJourney';
const description = setup
  ? 'Simpan password untuk akun pengelola dengan tautan privat yang kamu terima.'
  : 'Gunakan email dan password untuk membuka ruang pengelola.';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="robots" content="noindex, nofollow"/>
    <meta name="referrer" content="no-referrer"/>
    <meta name="theme-color" content="#f8f7f2"/>
    <title>{title} — MyJourney</title>
    <link rel="icon" href="/favicon.svg?v=myjourney" type="image/svg+xml"/>
  </head>
  <body>
    <a href="#auth-main" class="skip-link">Langsung ke formulir</a>
    <header class="site-top">
      <a class="wordmark" href="/" aria-label="Beranda MyJourney">MyJourney<span>.</span></a>
      <a class="back-link" href="/" rel="noreferrer"><span aria-hidden="true">←</span> Kembali ke website</a>
    </header>
    <main id="auth-main" class="auth-layout">
      <aside class="welcome" aria-label="Ruang pengelola MyJourney">
        <p class="eyebrow"><span></span> RUANG PENGELOLA</p>
        <h2>Tempat menata<br/>ide <em>berikutnya.</em></h2>
        <p class="welcome-copy">Tulisan yang berguna dimulai dari ruang untuk berpikir. Kelola cerita dan pilihan yang ingin kamu bagikan.</p>
        <div class="welcome-note"><span aria-hidden="true">✓</span><p>Satu langkah kecil.<br/>Perjalanan yang terus tumbuh.</p></div>
      </aside>
      <section class="auth-card" aria-labelledby="auth-title">
        <p class="eyebrow">{setup ? 'TAUTAN PRIVAT' : 'SELAMAT DATANG KEMBALI'}</p>
        <h1 id="auth-title">{title}</h1>
        <p class="intro" id="auth-description">{description}</p>
        {setup && <p class="setup-note">Tautan ini hanya dapat dipakai sekali dan memiliki masa berlaku. Isi formulir saat kamu siap menyimpan password baru.</p>}
        <form id="password-form" data-mode={mode} action={`/_emdash/api/auth/password/${setup ? 'setup' : 'login'}`} method="post" aria-describedby="auth-description">
          <p class="form-error" id="auth-error" role="alert" tabindex="-1" hidden></p>
          <fieldset id="auth-fields" disabled={setup}>
            <legend class="sr-only">{setup ? 'Data password baru' : 'Data login'}</legend>
            <div class="field">
              <label for="auth-email">Email</label>
              <input id="auth-email" name="email" type="email" autocomplete="username" inputmode="email" autocapitalize="none" spellcheck="false" required maxlength="254" placeholder="nama@contoh.com"/>
            </div>
            <div class="field">
              <label for="auth-password">{setup ? 'Password baru' : 'Password'}</label>
              <div class="password-field">
                <input id="auth-password" name="password" type="password" autocomplete={setup ? 'new-password' : 'current-password'} minlength={setup ? 15 : undefined} maxlength="128" required aria-describedby={setup ? 'password-help' : undefined}/>
                <button class="show-password" type="button" data-password-toggle="auth-password" aria-label={setup ? 'Tampilkan password baru' : 'Tampilkan password'} aria-controls="auth-password" aria-pressed="false">Tampilkan</button>
              </div>
              {setup && <p class="field-help" id="password-help">Gunakan 15–128 karakter. Frasa panjang yang mudah diingat juga boleh. Kamu bisa menempelkan password atau memakai pengelola password.</p>}
            </div>
            {setup && <div class="field">
              <label for="auth-confirm">Ulangi password baru</label>
              <div class="password-field">
                <input id="auth-confirm" name="confirmPassword" type="password" autocomplete="new-password" minlength="15" maxlength="128" required/>
                <button class="show-password" type="button" data-password-toggle="auth-confirm" aria-label="Tampilkan konfirmasi password" aria-controls="auth-confirm" aria-pressed="false">Tampilkan</button>
              </div>
            </div>}
            <button class="submit-button" type="submit" id="auth-submit">{setup ? 'Simpan password dan masuk' : 'Masuk'}<span aria-hidden="true">→</span></button>
          </fieldset>
          <p class="form-status" id="auth-status" role="status" aria-live="polite"></p>
        </form>
        <noscript><p class="form-error">Aktifkan JavaScript untuk menggunakan formulir masuk yang aman ini.</p></noscript>
        {!setup && <div class="alternate-login"><a id="passkey-link" href="/_emdash/admin/login?method=passkey" rel="noreferrer">Gunakan passkey</a></div>}
        {setup && <a class="login-link" href="/_emdash/admin/login" rel="noreferrer">Kembali ke login</a>}
        <p class="recovery-note">Lupa password? Hubungi pengelola VPS untuk membuat tautan reset privat.</p>
      </section>
    </main>
    <footer class="page-footer"><span>MyJourney</span><a href="/privacy/" rel="noreferrer">Kebijakan privasi</a></footer>
    <script>
      // Read and remove the private setup fragment before any asynchronous work.
      // The token remains only in this page's memory until the form is submitted.
      const currentUrl = new URL(window.location.href);
      let setupToken = new URLSearchParams(currentUrl.hash.slice(1)).get('token') || '';
      if (currentUrl.hash) {
        currentUrl.hash = '';
        window.history.replaceState(window.history.state, '', currentUrl.pathname + currentUrl.search);
      }

      const form = document.querySelector<HTMLFormElement>('#password-form');
      const fields = document.querySelector<HTMLFieldSetElement>('#auth-fields');
      const email = document.querySelector<HTMLInputElement>('#auth-email');
      const password = document.querySelector<HTMLInputElement>('#auth-password');
      const confirmation = document.querySelector<HTMLInputElement>('#auth-confirm');
      const submit = document.querySelector<HTMLButtonElement>('#auth-submit');
      const errorBox = document.querySelector<HTMLParagraphElement>('#auth-error');
      const status = document.querySelector<HTMLParagraphElement>('#auth-status');
      const isSetup = form?.dataset.mode === 'setup';
      let pending = false;

      function sameOriginPath(value: unknown): string | undefined {
        if (typeof value !== 'string' || !value.startsWith('/') || value.startsWith('//') || /[\\\x00-\x20\x7f]/.test(value)) return undefined;
        try {
          const target = new URL(value, window.location.origin);
          return target.origin === window.location.origin ? target.pathname + target.search + target.hash : undefined;
        } catch { return undefined; }
      }

      function showError(message: string, focus = true) {
        if (!errorBox) return;
        errorBox.textContent = message;
        errorBox.hidden = false;
        if (focus) errorBox.focus();
      }

      const requestedRedirect = new URLSearchParams(window.location.search).get('redirect');
      const passkeyLink = document.querySelector<HTMLAnchorElement>('#passkey-link');
      const safeRedirect = sameOriginPath(requestedRedirect);
      if (passkeyLink && safeRedirect) {
        const destination = new URL(passkeyLink.href);
        destination.searchParams.set('redirect', safeRedirect);
        passkeyLink.href = destination.pathname + destination.search;
      }

      document.querySelectorAll<HTMLButtonElement>('[data-password-toggle]').forEach((button) => {
        button.addEventListener('click', () => {
          const input = document.getElementById(button.dataset.passwordToggle || '');
          if (!(input instanceof HTMLInputElement)) return;
          const visible = input.type === 'password';
          input.type = visible ? 'text' : 'password';
          button.textContent = visible ? 'Sembunyikan' : 'Tampilkan';
          button.setAttribute('aria-pressed', String(visible));
          const label = input.id === 'auth-confirm' ? 'konfirmasi password' : isSetup ? 'password baru' : 'password';
          button.setAttribute('aria-label', `${visible ? 'Sembunyikan' : 'Tampilkan'} ${label}`);
        });
      });

      if (isSetup && fields) {
        fields.disabled = !setupToken;
        if (!setupToken) showError('Tautan penyiapan tidak lengkap. Minta tautan privat baru kepada pengelola VPS.', false);
      }

      const clearConfirmationError = () => {
        confirmation?.setCustomValidity('');
        confirmation?.removeAttribute('aria-invalid');
      };
      confirmation?.addEventListener('input', clearConfirmationError);
      password?.addEventListener('input', clearConfirmationError);

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (pending || !fields || !email || !password || !submit || !errorBox || !status) return;
        errorBox.hidden = true;
        status.textContent = '';
        if (isSetup && !setupToken) {
          showError('Tautan penyiapan tidak lengkap. Minta tautan privat baru kepada pengelola VPS.');
          return;
        }
        if (isSetup && confirmation && password.value !== confirmation.value) {
          confirmation.setCustomValidity('Password belum sama. Ulangi password baru dengan tepat.');
          confirmation.setAttribute('aria-invalid', 'true');
          showError('Password dan konfirmasinya belum sama.');
          confirmation.focus();
          return;
        }
        if (!form.reportValidity()) return;
        const payload = isSetup
          ? { email: email.value.trim(), password: password.value, token: setupToken }
          : { email: email.value.trim(), password: password.value, redirect: requestedRedirect };
        const buttonLabel = submit.innerHTML;
        pending = true;
        fields.disabled = true;
        form.setAttribute('aria-busy', 'true');
        submit.textContent = isSetup ? 'Menyimpan…' : 'Sedang masuk…';
        status.textContent = isSetup ? 'Menyimpan password baru.' : 'Memeriksa data masuk.';
        let leaving = false;
        try {
          const response = await fetch(isSetup ? '/_emdash/api/auth/password/setup' : '/_emdash/api/auth/password/login', {
            method: 'POST', credentials: 'same-origin', cache: 'no-store', referrerPolicy: 'no-referrer',
            headers: { 'Content-Type': 'application/json', 'X-EmDash-Request': '1' },
            body: JSON.stringify(payload),
          });
          const result: unknown = await response.json().catch(() => null);
          const data = result && typeof result === 'object' ? result as Record<string, unknown> : {};
          if (!response.ok || data.ok !== true) {
            const fallback = response.status === 429
              ? 'Percobaan terlalu sering. Tunggu beberapa saat sebelum mencoba lagi.'
              : isSetup ? 'Password belum dapat disimpan. Periksa tautan dan email, lalu coba lagi.' : 'Belum berhasil masuk. Periksa email dan password, lalu coba lagi.';
            showError(typeof data.error === 'string' && data.error.trim() ? data.error.slice(0, 500) : fallback);
            status.textContent = '';
            return;
          }
          const redirect = sameOriginPath(data.redirect);
          if (!redirect) {
            showError('Tujuan setelah masuk tidak valid. Silakan coba lagi.');
            status.textContent = '';
            return;
          }
          setupToken = '';
          password.value = '';
          if (confirmation) confirmation.value = '';
          status.textContent = 'Berhasil. Membuka ruang pengelola…';
          leaving = true;
          window.location.assign(redirect);
        } catch {
          showError('Koneksi belum berhasil. Periksa jaringan, lalu coba lagi.');
          status.textContent = '';
        } finally {
          pending = leaving;
          fields.disabled = leaving || (isSetup && !setupToken);
          if (!leaving) form.removeAttribute('aria-busy');
          submit.innerHTML = buttonLabel;
        }
      });
    </script>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box} :global(body){margin:0;background:#f8f7f2;color:#202f34;font:15px/1.6 Arial,sans-serif;-webkit-font-smoothing:antialiased} :global(a){color:inherit} :global(button),:global(input){font:inherit} :global(button),:global(a),:global(input){touch-action:manipulation} :global([hidden]){display:none!important}
  a,button,input{outline-offset:4px} a:focus-visible,button:focus-visible,input:focus-visible,[tabindex="-1"]:focus-visible{outline:3px solid #9d6c25} .skip-link{position:absolute;top:-100px;left:20px;z-index:5;background:#294c3d;color:white;padding:12px}.skip-link:focus{top:12px}
  .site-top,.page-footer{width:min(1120px,calc(100% - 80px));margin-inline:auto;display:flex;justify-content:space-between;align-items:center;gap:20px}.site-top{min-height:108px;border-bottom:1px solid #dce0d7}.wordmark{display:inline-flex;align-items:center;min-height:44px;font:600 35px/1 Georgia,'Times New Roman',serif;letter-spacing:-1.8px;text-decoration:none;white-space:nowrap}.wordmark span{color:#ae6846}.back-link{min-height:44px;display:inline-flex;align-items:center;gap:10px;text-decoration:none;font-size:12px;color:#5a686a}.back-link:hover{color:#294c3d}.back-link span{font-size:20px}
  .auth-layout{width:min(1000px,calc(100% - 80px));margin:70px auto 80px;display:grid;grid-template-columns:1fr minmax(0,450px);align-items:center;gap:76px}.eyebrow{font-size:10px;line-height:1.5;font-weight:700;letter-spacing:1.7px;color:#5a686a;margin:0 0 18px}.welcome .eyebrow{display:flex;align-items:center;gap:12px}.eyebrow span{height:1px;width:25px;background:#294c3d}.welcome h2{font:400 57px/1.08 Georgia,'Times New Roman',serif;letter-spacing:-2px;margin:0 0 24px}.welcome em{color:#294c3d}.welcome-copy{font-size:14px;line-height:1.9;color:#5a686a;max-width:330px;margin:0}.welcome-note{display:flex;align-items:center;gap:12px;margin-top:42px}.welcome-note>span{height:32px;width:32px;border-radius:50%;border:1px solid #b8c6b5;display:grid;place-items:center;color:#294c3d}.welcome-note p{font-size:11px;line-height:1.8;color:#5a686a;margin:0}
  .auth-card{background:#fffefa;border:1px solid #dce0d7;border-radius:8px;padding:36px;box-shadow:0 12px 44px #202f3405;min-width:0}.auth-card h1{font:400 35px/1.15 Georgia,'Times New Roman',serif;letter-spacing:-1px;margin:0 0 15px}.auth-card>.eyebrow{font-size:9px;margin-bottom:15px}.intro{font-size:13px;color:#5a686a;margin:0 0 27px;line-height:1.8}.setup-note{font-size:12px;line-height:1.8;color:#5a686a;padding:13px 15px;border-left:2px solid #b8c6b5;background:#edf0e7;margin:-9px 0 25px}
  fieldset{border:0;padding:0;margin:0;min-width:0}.field{margin-bottom:21px}label{display:block;font-size:12px;font-weight:600;margin-bottom:8px}input{display:block;width:100%;font-size:16px;min-height:56px;padding:14px 15px;color:#202f34;border:1px solid #b8c6b5;border-radius:4px;background:#fff;min-width:0}input::placeholder{color:#778281}input[aria-invalid="true"]{border-color:#9c4136}.password-field{position:relative}.password-field input{padding-right:113px}.show-password{position:absolute;right:5px;top:6px;min-height:44px;min-width:96px;padding:8px 9px;border:0;border-radius:3px;background:#f2f3ec;color:#294c3d;font-size:11px;cursor:pointer}.show-password:hover{background:#e6ebdf}.field-help{font-size:11px;line-height:1.8;margin:9px 0 0;color:#5a686a}.submit-button{display:flex;align-items:center;justify-content:center;gap:20px;width:100%;min-height:54px;padding:13px 15px;background:#294c3d;color:white;border:1px solid #294c3d;border-radius:4px;font-size:13px;font-weight:600;cursor:pointer}.submit-button>span{font-size:18px;font-weight:400}.submit-button:hover{background:#19382b}fieldset:disabled .submit-button{opacity:.7;cursor:wait}fieldset:disabled input{background:#f4f4ef}.form-error{border-left:3px solid #9c4136;background:#faf0e9;color:#76392f;padding:12px 14px;font-size:12px;line-height:1.8;margin:0 0 22px;overflow-wrap:anywhere}.form-status{font-size:12px;color:#5a686a;margin:12px 0 0;min-height:0}.form-status:empty{display:none}.alternate-login{margin-top:21px;padding-top:18px;border-top:1px solid #e4e7dd;text-align:center}.alternate-login a,.login-link{display:inline-flex;align-items:center;justify-content:center;min-height:44px;font-size:12px;text-underline-offset:4px;color:#294c3d}.login-link{margin-top:12px;width:100%}.recovery-note{font-size:11px;line-height:1.8;color:#5a686a;margin:20px 0 0}.page-footer{padding-block:22px;border-top:1px solid #dce0d7;font-size:10px;color:#5a686a}.page-footer a{min-height:44px;display:inline-flex;align-items:center;text-underline-offset:4px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  @media(max-width:900px){.auth-layout{gap:35px}.welcome h2{font-size:47px}.auth-card{padding:28px}.auth-card h1{font-size:32px}}
  @media(max-width:700px){.site-top,.page-footer{width:calc(100% - 40px)}.site-top{min-height:88px}.wordmark{font-size:30px}.back-link{font-size:11px;gap:6px}.auth-layout{width:min(450px,calc(100% - 40px));grid-template-columns:1fr;margin-block:35px 45px;gap:0}.welcome{display:none}.auth-card{padding:27px 24px}.auth-card h1{font-size:34px}.page-footer{padding-block:12px}}
  @media(max-width:360px){.site-top,.page-footer{width:calc(100% - 32px)}.wordmark{font-size:27px}.back-link{font-size:10px}.auth-layout{width:calc(100% - 32px)}.auth-card{padding:25px 20px}.auth-card h1{font-size:31px}.password-field input{padding-right:105px}.show-password{min-width:89px;font-size:10px}}
  @media(prefers-reduced-motion:no-preference){a,button,input{transition:background .15s,border-color .15s}}
</style>
