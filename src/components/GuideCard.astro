---
import Icon from './Icon.astro';
import { categories } from '../data/guides';
import type { UnifiedGuide } from '../lib/content';
interface Props { guide: UnifiedGuide; index?: number; compact?: boolean }
const { guide, index=0, compact=false } = Astro.props;
const illustrations: Record<string,string> = {workspace: '/images/workspace.svg', lighting: '/images/lighting.svg', accessories: '/images/accessories.svg'};
---
<article class:list={['guide-card', { compact }]}>
  <a href={`/articles/${guide.slug}/`} class="card-image" aria-label={guide.title}>
    <img src={illustrations[guide.category] || illustrations.workspace} alt="" width="640" height="420" loading="lazy" />
    <span class="card-number">{String(index+1).padStart(2,'0')}</span>
    <span class="card-image-arrow"><Icon/></span>
  </a>
  <div class="card-copy">
    <p class="eyebrow">{categories[guide.category]?.title || 'Guide'} <span>·</span> {guide.readingMinutes} min read</p>
    <h3><a href={`/articles/${guide.slug}/`}>{guide.title}</a></h3>
    <p>{guide.summary}</p>
    <a class="text-link" href={`/articles/${guide.slug}/`}>Read the guide <Icon size={17}/></a>
  </div>
</article>
