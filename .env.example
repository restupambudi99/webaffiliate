# Generate a private key with npm run cms:key. Never commit the real .env file.
EMDASH_ENCRYPTION_KEY=
# Set both before deploying a Node server behind a proxy, using its HTTPS origin.
SITE_URL=https://affiliate.restupambudi.my.id
EMDASH_SITE_URL=https://affiliate.restupambudi.my.id
# Demonstration drafts are visible only when explicitly enabled. Production: false.
STAGING_PREVIEW=false
# Production: keep all /_emdash routes closed until the owner is ready for setup.
CMS_ADMIN_ENABLED=false
# Node deployments: set the same absolute persistent paths at build and runtime.
# EMDASH_DATABASE_URL=file:/var/lib/desk-edit/content.db
# EMDASH_UPLOADS_DIR=/var/lib/desk-edit/uploads
# EMDASH_SESSIONS_DIR=/var/lib/desk-edit/sessions
AFFILIATE_MODE=editorial_only
AMAZON_ASSOCIATE_TAG=
AMAZON_SITE_REGISTERED=false
CONTACT_EMAIL=nikolasjuan34@gmail.com
